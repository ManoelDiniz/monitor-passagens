# ---------------------------------------------------------------
# Copie este arquivo para ".env".
# "kiwi" funciona sem configurar nada — os outros dois sao opcionais.
# ---------------------------------------------------------------

# Fontes usadas. kiwi, maxmilhas e google nao precisam de chave.
PROVIDER_ORDER=kiwi,maxmilhas,google

# merge    = consulta todas as fontes e fica com o melhor preco (padrao)
# failover = usa a primeira que responder e ignora o resto
PROVIDER_MODE=merge

# Tentativas por requisicao antes de considerar a fonte fora do ar.
# A espera cresce entre elas (2s, 6s, 18s) e respeita o Retry-After.
PROVIDER_RETRIES=3
# Depois de N falhas seguidas a fonte fica suspensa por M minutos. Insistir de
# hora em hora numa API que ja recusou troca erro temporario por bloqueio.
PROVIDER_BREAKER_FAILURES=3
PROVIDER_BREAKER_MINUTES=15

# Teto de dias consultados por rota em cada rodada, quando a rota tem
# flexibilidade de datas cadastrada ("+/- N dias" no formulario).
#
# Este e o freio de custo da busca por periodo: uma rota com +/- 7 dias sao 15
# consultas por rodada em cada fonte, contra 1 de uma rota de data fixa. A Kiwi
# resolve a janela de so-ida numa chamada so; ida-e-volta vai dia a dia porque
# um intervalo nas duas pontas devolveria viagens com outra duracao.
#
# Baixe este numero para segurar o custo sem editar as rotas uma a uma: os dias
# cortados sao sempre os mais distantes da data escolhida, e o corte aparece no
# log. 15 e o maximo que o formulario permite cadastrar.
SEARCH_MAX_DATES=15

# --- Kiwi e MaxMilhas (sem chave) ------------------------------
# Usam as APIs internas dos proprios sites. Nao ha nada para configurar.
# Contrapartida: se eles mudarem a API, o arquivo do provedor
# (src/providers/kiwi.ts, maxmilhas.ts ou google.ts) precisa ser ajustado.

# --- Travelpayouts (gratuito) ----------------------------------
# https://www.travelpayouts.com  -> cadastro -> API tokens
# Melhor cobertura de rotas domesticas do Brasil (GOL/LATAM/Azul).
# Precos vem de cache de buscas recentes, nao sao cotacao ao vivo.
TRAVELPAYOUTS_TOKEN=

# --- Amadeus Self-Service (gratuito) ---------------------------
# https://developers.amadeus.com -> Self-Service -> My Apps
# Precos de GDS, mais precisos, porem quota mensal limitada.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (dados limitados, quota generosa) ou "production"
AMADEUS_ENV=test

# --- Banco de dados (MySQL 8) ----------------------------------
# Crie o banco antes de subir:
#   CREATE DATABASE monitor CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-pela-sua-senha
DB_NAME=monitor
# true = o TypeORM cria e ajusta as tabelas a partir das entities.
# false = voce assume o controle do esquema com migrations.
DB_SYNCHRONIZE=true
# true imprime todo SQL executado. Util para depurar, barulhento no dia a dia.
DB_LOGGING=false

# --- Agendamento -----------------------------------------------
# De quantas em quantas horas consultar. 1 = de hora em hora.
SCHEDULE_EVERY_HOURS=1
# Para horarios fixos em vez do intervalo, descomente e liste-os (24h):
# SCHEDULE_TIMES=08:00,12:00,18:00
TIMEZONE=America/Sao_Paulo

# --- Alertas ---------------------------------------------------
# Avisa quando o preco cair essa porcentagem em relacao a consulta anterior.
DROP_ALERT_PCT=10
# Nao repete o mesmo alerta para a mesma rota antes desse intervalo (horas).
# Minimo historico nunca respeita cooldown.
NOTIFY_COOLDOWN_HOURS=6

# --- Backup do banco -------------------------------------------
# Copia diaria com mysqldump em data/backups. O historico de precos
# nao se refaz: se o banco for perdido, o passado vai junto.
BACKUP_ENABLED=true
# Horario da copia (24h). Madrugada para nao concorrer com as consultas.
BACKUP_TIME=04:00
# Quantas copias manter. As mais antigas sao apagadas.
BACKUP_KEEP=7
# Pasta de destino. Vazio = data/backups dentro do projeto.
# BACKUP_DIR=
# Depois de N dias, cada consulta guarda so a melhor oferta. Sao ~120 ofertas
# por consulta e 24 consultas por dia: sem isso a tabela cresce ~5 GB por mes.
# O historico de precos do painel e o menor preco de cada consulta, ou seja,
# exatamente a linha preservada — nenhum numero da tela muda. 0 desliga.
OFFERS_RETENTION_DAYS=30
# Caminho do mysqldump.exe. Vazio = procura na instalacao padrao do
# MySQL e depois no PATH.
# MYSQLDUMP_PATH=

# --- Telegram (opcional, mas e o aviso que chega no celular) ---
# 1. Crie um bot com o @BotFather e cole o token aqui. Cuidado ao copiar:
#    a parte depois dos dois pontos tem exatamente 35 caracteres, e a frase
#    seguinte do BotFather ("Keep your token secure") cola no final dele.
# 2. Toque em Iniciar na conversa com o seu bot.
# 3. Rode "npm run telegram" — ele descobre o chat id e manda um teste.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Painel local ----------------------------------------------
PORT=3777

# --- Cambio ----------------------------------------------------
# Ativos acompanhados: DOLA11 (ETF de dolar na B3), USD e EUR (conta global).
CAMBIO_ENABLED=true
CAMBIO_ATIVOS=DOLA11,USD,EUR
CAMBIO_HISTORICO_ANOS=5
# Conta global: IOF 3,5% na ida (Decreto 12.499/2025), 0,38% na volta, mais o
# spread da plataforma. Confira o spread real da sua no primeiro lancamento.
CAMBIO_CONTA_IOF_COMPRA_PCT=3.5
CAMBIO_CONTA_IOF_VENDA_PCT=0.38
CAMBIO_CONTA_SPREAD_PCT=1
# ETF: sem IOF; spread do book + emolumentos; IR de 15% sobre o ganho.
CAMBIO_ETF_SPREAD_PCT=0.2
CAMBIO_ETF_IR_PCT=15
# Sinal: faixa de N pregoes, tendencia curta, zonas e saidas.
CAMBIO_JANELA_CURTA=4
CAMBIO_JANELA_LONGA=90
CAMBIO_ZONA_COMPRA=0.2
CAMBIO_ZONA_VENDA=0.8
CAMBIO_ALVO_LUCRO_PCT=3
CAMBIO_STOP_PCT=8
CAMBIO_ALERTA_COOLDOWN_HORAS=24

# --- Cripto ----------------------------------------------------
# Moedas do radar (precisam existir em BRL no Mercado Bitcoin).
CRIPTO_ENABLED=true
CRIPTO_MOEDAS=BTC,ETH,SOL,XRP,ADA,LINK,DOT,AVAX,LTC,UNI,AAVE
CRIPTO_HISTORICO_DESDE=2018-01-01
# BTG: ate 1% por ordem, em cada perna, + spread embutido estimado.
CRIPTO_TAXA_PCT=1
CRIPTO_SPREAD_PCT=0.5
# Vendas ate R$ 35 mil/mes sao isentas de IR.
CRIPTO_IR_PCT=0
# Regra da grade (padrao do teste fora da amostra: npm run estudo-cripto).
CRIPTO_JANELA_QUEDA=7
CRIPTO_QUEDA_PCT=20
CRIPTO_ALVO_PCT=3
CRIPTO_STOP_PCT=25
CRIPTO_PARTES=4
CRIPTO_ESPACAMENTO_PCT=20
CRIPTO_TENDENCIA_DIAS=100
CRIPTO_FILTRO_TENDENCIA=false
CRIPTO_HORIZONTE_DIAS=14
CRIPTO_TAXA_MINIMA=0.6
CRIPTO_ALERTA_COOLDOWN_HORAS=24
