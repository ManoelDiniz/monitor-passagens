{
  "name": "monitor-passagens",
  "version": "1.0.0",
  "private": true,
  "description": "Monitor automatico de precos de passagens aereas",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "web:dev": "vite --config web/vite.config.mts",
    "web:build": "vite build --config web/vite.config.mts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test tests/route-input.test.ts tests/date-window.test.ts tests/format.test.ts tests/airports.test.ts tests/providers.test.ts tests/notifier.test.ts tests/cambio.test.ts tests/cripto.test.ts",
    "lint": "eslint src web/src tests",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.mts",
    "check-now": "tsx src/cli/check-now.ts",
    "migrar-mysql": "tsx src/cli/migrar-mysql.ts",
    "backup": "tsx src/cli/backup.ts",
    "compactar": "tsx src/cli/compactar.ts",
    "telegram": "tsx src/cli/telegram.ts",
    "comparar": "tsx src/cli/comparar.ts",
    "backtest-cambio": "tsx src/cli/backtest-cambio.ts",
    "estudo-cripto": "tsx src/cli/estudo-cripto.ts",
    "install-startup": "powershell -ExecutionPolicy Bypass -File scripts/install-startup.ps1",
    "uninstall-startup": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-startup.ps1"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "mysql2": "^3.23.2",
    "node-cron": "^3.0.3",
    "node-notifier": "^10.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  }
}
